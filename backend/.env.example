# ====================================================================
# VEDHA Backend Environment Configuration (.env)
# ====================================================================

# Port the Express server listens on
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS (e.g. your local Vite or Vercel production domain)
FRONTEND_URL=http://localhost:3000

# Supabase Cloud Database Configuration
# Find these in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL Database Connection URL (Optional / Supabase Transaction pooler)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# JWT Secret for Session Authentication
JWT_SECRET=vedha_super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d
